# Burpsuite environment — sourced automatically by the container's .zshrc.

# Path where burp-cert writes the PEM-converted CA cert.
# Run burp-cert after starting Burpsuite to populate it.
export BURP_CA="/certs/burp-ca.pem"

# Burpsuite proxy listener (Burpsuite running locally inside the container).
export BURP_PROXY="http://127.0.0.1:8080"

# JVM options for Burpsuite:
#   -Xmx4g         — 4 GB heap; raise to -Xmx8g on memory-rich hosts
#   font flags     — enable sub-pixel antialiasing for readability over X11
# Applied via JAVA_TOOL_OPTIONS so Kali's burpsuite wrapper picks them up.
export BURP_JVM_OPTS="-Xmx4g -Dawt.useSystemAAFontSettings=on -Dswing.aatext=true"
export JAVA_TOOL_OPTIONS="${BURP_JVM_OPTS}"

# Proxy routing — uncomment to transparently route all tool traffic through
# Burpsuite. Requires Burpsuite to be running and burp-cert to have been run.
#
# export http_proxy="${BURP_PROXY}"
# export https_proxy="${BURP_PROXY}"
# export CURL_CA_BUNDLE="${BURP_CA}"        # curl / wget
# export REQUESTS_CA_BUNDLE="${BURP_CA}"    # Python requests / httpx
